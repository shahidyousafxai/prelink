{
  "expo": {
    "name": "prelink",
    "slug": "prelink",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.prelink"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.anonymous.prelink"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "7f9fe74a-b925-4ccd-9108-4425584f641a"
      }
    },
    "owner": "shahid.bahadur",
    "plugins": [
      "expo-secure-store",
      "expo-splash-screen",
      "expo-font",
      "expo-localization"
    ]
  }
}
